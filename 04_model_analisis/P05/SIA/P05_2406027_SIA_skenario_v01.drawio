<mxfile host="65bd71144e">
    <diagram id="s0" name="SIA-UC07">
        <mxGraphModel dx="843" dy="874" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;overflow=fill;fillColor=none;strokeColor=none;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px;&quot; cellpadding=&quot;4&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;4&quot;&gt;&lt;b&gt;Tabel 5.1 Skenario Use Case SIA-UC07 Lihat Kalender Akademik&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;SIA-UC07 Lihat Kalender Akademik&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;Civitas Akademika (berlaku untuk Mahasiswa dan Dosen)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;Civitas Akademika dapat mengetahui agenda resmi institusi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;Civitas Akademika membuka fungsi kalender akademik, memilih semester, dan melihat agenda resmi institusi seperti awal semester, batas KRS, dan masa ujian&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;&lt;b&gt;Kegiatan&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;&lt;b&gt;Respon sistem&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;4&quot;&gt;&lt;b&gt;Skenario Normal&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;1. Civitas Akademika membuka fungsi Lihat Kalender Akademik&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;2. Sistem menampilkan daftar semester&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;3. Civitas Akademika memilih semester&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;4. Sistem menampilkan agenda resmi semester tersebut, yaitu nama agenda, tanggal mulai, dan tanggal selesai&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;4&quot;&gt;&lt;b&gt;Skenario Alternative&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;5. Belum ada agenda pada semester yang dipilih (cabang dari langkah 4)&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;6. Sistem menampilkan pesan belum ada agenda akademik pada semester tersebut&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;Use case selesai jika agenda resmi semester yang dipilih ditampilkan; jika belum ada agenda, use case selesai dengan pesan tersebut.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p style=&quot;font-size:10px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
                    <mxGeometry height="495" width="800" x="40" y="30" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="s1" name="SIA-UC08">
        <mxGraphModel dx="843" dy="874" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;overflow=fill;fillColor=none;strokeColor=none;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px;&quot; cellpadding=&quot;4&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;4&quot;&gt;&lt;b&gt;Tabel 5.2 Skenario Use Case SIA-UC08 Input Nilai Mata Kuliah&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;SIA-UC08 Input Nilai Mata Kuliah&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;Dosen&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;Nilai mata kuliah mahasiswa tercatat oleh dosen pengampu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;Dosen memilih mata kuliah yang diampunya, mengisi nilai setiap mahasiswa peserta, dan menyimpan nilai. Prasyarat: dosen adalah pengampu mata kuliah tersebut dan masa perkuliahan telah berakhir&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;&lt;b&gt;Kegiatan&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;&lt;b&gt;Respon sistem&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;4&quot;&gt;&lt;b&gt;Skenario Normal&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;1. Dosen membuka fungsi Input Nilai Mata Kuliah&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;2. Sistem menampilkan daftar mata kuliah yang diampu dosen&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;3. Dosen memilih mata kuliah&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;4. Sistem memeriksa bahwa dosen adalah pengampu dan masa perkuliahan telah berakhir, lalu menampilkan daftar mahasiswa peserta beserta kolom nilai&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;5. Dosen mengisi nilai setiap mahasiswa&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;6. Sistem menampung isian nilai&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;7. Dosen menyimpan nilai&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;8. Sistem memeriksa setiap nilai berada pada rentang yang sah&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;-&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;9. Sistem menyimpan nilai dengan status Belum Dipublikasikan dan menampilkan konfirmasi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;4&quot;&gt;&lt;b&gt;Skenario Alternative&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;10. Dosen bukan pengampu mata kuliah terpilih (cabang dari langkah 4)&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;11. Sistem menolak penginputan dan menampilkan pesan dosen bukan pengampu mata kuliah tersebut&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;12. Masa perkuliahan belum berakhir (cabang dari langkah 4)&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;13. Sistem menolak penginputan dan menampilkan pesan masa perkuliahan belum berakhir&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;14. Nilai di luar rentang yang sah (cabang dari langkah 8)&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;15. Sistem menolak penyimpanan, menandai nilai yang tidak sah, dan meminta dosen mengoreksi nilai&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;Use case selesai jika nilai tersimpan dengan status Belum Dipublikasikan; jika dosen bukan pengampu, masa perkuliahan belum berakhir, atau ada nilai di luar rentang yang sah, tidak ada nilai yang tersimpan dan data nilai tidak berubah.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p style=&quot;font-size:10px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
                    <mxGeometry height="720" width="800" x="40" y="30" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="s2" name="SIA-UC09">
        <mxGraphModel dx="843" dy="874" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;overflow=fill;fillColor=none;strokeColor=none;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px;&quot; cellpadding=&quot;4&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;4&quot;&gt;&lt;b&gt;Tabel 5.3 Skenario Use Case SIA-UC09 Lihat KHS&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;SIA-UC09 Lihat KHS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;Mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;Mahasiswa dapat mengetahui hasil studi pada semester yang nilainya sudah dipublikasikan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;Mahasiswa membuka fungsi KHS, memilih semester, dan melihat Kartu Hasil Studi yang hanya memuat nilai yang sudah dipublikasikan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;&lt;b&gt;Kegiatan&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;&lt;b&gt;Respon sistem&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;4&quot;&gt;&lt;b&gt;Skenario Normal&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;1. Mahasiswa membuka fungsi Lihat KHS&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;2. Sistem menampilkan daftar semester yang nilainya sudah dipublikasikan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;3. Mahasiswa memilih semester&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;4. Sistem menampilkan KHS semester tersebut, yaitu nama mata kuliah dan nilai yang sudah dipublikasikan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;4&quot;&gt;&lt;b&gt;Skenario Alternative&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;5. Belum ada semester yang nilainya dipublikasikan (cabang dari langkah 2)&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;6. Sistem menampilkan pesan KHS belum tersedia&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;7. Sebagian nilai pada semester terpilih belum dipublikasikan (cabang dari langkah 4)&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;8. Sistem hanya menampilkan nilai yang sudah dipublikasikan dan tidak menampilkan nilai yang belum dipublikasikan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;Use case selesai jika KHS semester terpilih ditampilkan dengan nilai yang sudah dipublikasikan; jika belum ada nilai terpublikasi, use case selesai dengan pesan KHS belum tersedia.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p style=&quot;font-size:10px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
                    <mxGeometry height="510" width="800" x="40" y="30" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="s3" name="SIA-UC10">
        <mxGraphModel dx="843" dy="874" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;overflow=fill;fillColor=none;strokeColor=none;" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px;&quot; cellpadding=&quot;4&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;4&quot;&gt;&lt;b&gt;Tabel 5.4 Skenario Use Case SIA-UC10 Kelola Data Mahasiswa&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Nama use case&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;SIA-UC10 Kelola Data Mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Aktor&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;Admin Akademik&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Tujuan&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;Data mahasiswa terkelola melalui satu fungsi pengelolaan bersama&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Deskripsi&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;Admin Akademik membuka fungsi pengelolaan data mahasiswa, memilih bentuk pengelolaan, dan menyimpan perubahan. Bentuk tambah, ubah, dan hapus dijabarkan pada tabel khususnya masing-masing&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;&lt;b&gt;Kegiatan&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;&lt;b&gt;Respon sistem&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;4&quot;&gt;&lt;b&gt;Skenario Normal&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;1. Admin Akademik membuka fungsi Kelola Data Mahasiswa&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;2. Sistem menampilkan daftar data mahasiswa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;3. Admin Akademik memilih bentuk pengelolaan, yaitu tambah, ubah, atau hapus&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;4. Sistem menampilkan formulir sesuai bentuk pengelolaan yang dipilih&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;5. Admin Akademik mengisi atau mengonfirmasi data&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;6. Sistem memeriksa kelengkapan dan keabsahan data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;7. Admin Akademik menyimpan perubahan&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;8. Sistem menyimpan perubahan dan menampilkan konfirmasi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;4&quot;&gt;&lt;b&gt;Skenario Alternative&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;9. Data tidak lengkap atau tidak sah (cabang dari langkah 6)&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;2&quot;&gt;10. Sistem menolak penyimpanan dan menampilkan pesan kesalahan data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot;&gt;Skenario Akhir&lt;/td&gt;&lt;td style=&quot;border: 1px solid rgb(0, 0, 0); padding: 4px; vertical-align: top;&quot; colspan=&quot;3&quot;&gt;Use case selesai jika perubahan data mahasiswa tersimpan; jika data tidak lengkap atau tidak sah, perubahan tidak tersimpan.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p style=&quot;font-size:10px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
